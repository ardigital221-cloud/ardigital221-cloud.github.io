91,"imgs":392},"/projects/procorlab","Procorlab",[393],{"ruta":394,"alt":97},"/carlos3/img/procor.jpg",{},"projects/oir10","9l0JFDkgh71ER4nTHlVimOIelxbmOX-lNmttzjcPUYg",{"id":399,"title":400,"body":7,"description":7,"extension":8,"meta":401,"navigation":98,"path":277,"seo":452,"stem":453,"__hash__":454},"projects/projects/overshoot.json","Overshoot",{"order":402,"name":278,"year":231,"thumb":281,"slug":403,"relacionados":404},3,"/overshoot",{"1":405},[406,419,424,430,435,437,448],{"comp_type":18,"comp_var":19,"class":20,"html":407,"imgs":410,"cards":413,"link":418},[408],{"title":278,"description":409},"The Overshoot is an e-commerce website that I designed and developed for a company that sells mountain and winter clothing.",[411],{"ruta":281,"alt":412},"The Overshoot — project hero image",[414,415,416,417],{"text":30,"class":31},{"text":33,"class":34},{"text":364,"class":37},{"text":231,"class":39},"https://www.theovershoot.com/",{"comp_type":42,"comp_var":43,"imgs":420},[421],{"ruta":422,"alt":423},"https://res.cloudinary.com/df5xojjiw/image/upload/v1734258971/overshoot-blog-desktop-min_ymbyvj.png","The Overshoot blog section on desktop",{"comp_type":49,"comp_var":19,"description":425,"imgs":426},"The Overshoot website was designed with a focus on user experience, ensuring that customers can easily navigate the site and find the products they need.",[427],{"ruta":428,"alt":429},"https://res.cloudinary.com/df5xojjiw/image/upload/v1734259038/overshoot-detail-mobile_pjebrn.png","The Overshoot product detail on mobile",{"comp_type":42,"comp_var":43,"imgs":431},[432],{"ruta":433,"alt":434},"https://res.cloudinary.com/df5xojjiw/image/upload/v1734259042/overshoot-detail-desktop_tbyv4p.png","The Overshoot product detail on desktop",{"comp_type":73,"comp_var":57,"description":436},"The overshoot crew is a young and adventurous team, so the design of the website had to reflect this spirit and energy.",{"id":76,"comp_type":77,"comp_var":78,"imgs":438},[439,442,445],{"ruta":440,"alt":441},"https://res.cloudinary.com/df5xojjiw/image/upload/v1734259043/overshoot-home-desktop_jvutvy.png","The Overshoot homepage on desktop",{"ruta":443,"alt":444},"https://res.cloudinary.com/df5xojjiw/image/upload/v1734259042/overshoot-shop-desktop_zxdoxx.png","The Overshoot shop on desktop",{"ruta":446,"alt":447},"https://res.cloudinary.com/df5xojjiw/image/upload/v1734258972/overshoot-shop-mobile-min_zwqu1w.png","The Overshoot shop on mobile",{"comp_type":90,"comp_var":91,"link":222,"description":449,"imgs":450},"Bat architecture",[451],{"ruta":173,"alt":97},{},"projects/overshoot","AGF00dBv2EV_1WlEeE-d9M-DmQIJkOwEwkk9xn2tG6g",{"id":456,"title":391,"body":7,"description":7,"extension":8,"meta":457,"navigation":98,"path":390,"seo":507,"stem":508,"__hash__":509},"projects/projects/procorlab.json",{"order":458,"name":391,"year":459,"thumb":394,"slug":460,"relacionados":461},8,"2022","/procorlab",{"1":462},[463,475,480,482,490,492,501],{"comp_type":18,"comp_var":19,"class":20,"html":464,"imgs":467,"cards":470},[465],{"title":391,"description":466},"Procorlab is the website of Procor, a company founded during the pandemic to provide COVID tests and offer a booking service for testing in Madrid. For this project, I developed an e-commerce platform, an appointment booking system, a private client area for customer information, and a blog.",[468],{"ruta":394,"alt":469},"Procorlab — project hero image",[471,472,473,474],{"text":123,"class":31},{"text":33,"class":34},{"text":364,"class":37},{"text":459,"class":39},{"comp_type":42,"comp_var":43,"imgs":476},[477],{"ruta":478,"alt":479},"https://res.cloudinary.com/df5xojjiw/image/upload/v1734252817/procor_blog-ipad-min_uylgcj.png","Procorlab blog on iPad",{"comp_type":73,"comp_var":134,"description":481},"Ensuring a seamless user experience was a key focus of the project, with a clean and intuitive design that made it easy for users to navigate the site and find the information they needed.",{"id":148,"comp_type":77,"comp_var":149,"imgs":483},[484,487],{"ruta":485,"alt":486},"https://res.cloudinary.com/df5xojjiw/image/upload/v1732382969/procor_hero-laptop_j3edux.png","Procorlab homepage on laptop",{"ruta":488,"alt":489},"https://res.cloudinary.com/df5xojjiw/image/upload/v1732382974/procor_post-iphone_u1hedl.png","Procorlab post detail on iPhone",{"comp_type":73,"comp_var":57,"description":491}," The e-commerce platform was designed to be user-friendly and efficient, allowing customers to easily book appointments and purchase COVID tests online.",{"id":76,"comp_type":77,"comp_var":78,"imgs":493},[494,497,498],{"ruta":495,"alt":496},"https://res.cloudinary.com/df5xojjiw/image/upload/v1732384163/procor_shop-laptop_bhvszw_c_crop_ar_4_3_mshzvh.png","Procorlab shop on laptop",{"ruta":485,"alt":486},{"ruta":499,"alt":500},"https://res.cloudinary.com/df5xojjiw/image/upload/v1732383104/procor_hero-iphone_dsxcwj_c_crop_ar_9_16_bo6q2r.png","Procorlab homepage on iPhone",{"comp_type":90,"comp_var":91,"link":502,"description":503,"imgs":504},"/projects/wave-maps","Wave maps",[505],{"ruta":506,"alt":97},"/carlos3/img/wavemaps.jpg",{},"projects/procorlab","DEo6Y06iDP0JVeI8g1ap9w5jEDl7GDqmwNCiB6bk7Ho",{"id":511,"title":512,"body":7,"description":7,"extension":8,"meta":513,"navigation":98,"path":502,"seo":562,"stem":563,"__hash__":564},"projects/projects/wave-maps.json","Wave Maps",{"order":514,"name":503,"year":459,"thumb":506,"slug":515,"relacionados":516},9,"/wave-maps",{"1":517},[518,530,535,537,545,547,558],{"comp_type":18,"comp_var":19,"class":20,"html":519,"imgs":522,"cards":525},[520],{"title":512,"description":521},"Wave Maps is a wave atlas website that I designed & developed in collaboration with developer Eva Virseda. The site provides detailed information about surf spots, including interactive maps and wave characteristics. The goal of the project was to create a website that offered practical information about waves while also being visually appealing and easy to navigate.",[523],{"ruta":506,"alt":524},"Wave Maps — project hero image",[526,527,528,529],{"text":123,"class":31},{"text":33,"class":34},{"text":126,"class":37},{"text":459,"class":39},{"comp_type":42,"comp_var":43,"imgs":531},[532],{"ruta":533,"alt":534},"https://res.cloudinary.com/df5xojjiw/image/upload/v1734252817/wm_asia-iphone-min_l7pild.png","Wave Maps Asia view on iPhone",{"comp_type":73,"comp_var":134,"description":536},"One of the main challenges of this project was to create a design that could effectively present complex information about waves and surf spots in a way that was both visually appealing and easy to understand.",{"id":148,"comp_type":77,"comp_var":149,"imgs":538},[539,542],{"ruta":540,"alt":541},"https://res.cloudinary.com/df5xojjiw/image/upload/v1734252816/wm_hero-laptop-min_rjrasu.png","Wave Maps homepage on laptop",{"ruta":543,"alt":544},"https://res.cloudinary.com/df5xojjiw/image/upload/v1732378610/wm_america-ipad_ubtgry.png","Wave Maps America view on iPad",{"comp_type":73,"comp_var":57,"description":546},"The design of the website is clean and modern, with a focus on high-quality visuals and easy navigation. The use of interactive maps allows users to explore different surf spots and learn about their wave characteristics in an engaging way.",{"id":76,"comp_type":77,"comp_var":78,"imgs":548},[549,552,555],{"ruta":550,"alt":551},"https://res.cloudinary.com/df5xojjiw/image/upload/v1734252817/wm_aus-laptop-min_woauct.png","Wave Maps Australia view on laptop",{"ruta":553,"alt":554},"https://res.cloudinary.com/df5xojjiw/image/upload/v1732379005/wm_login-laptop_bsrfcb_c_crop_ar_4_3_koouhd.png","Wave Maps login page on laptop",{"ruta":556,"alt":557},"https://res.cloudinary.com/df5xojjiw/image/upload/v1732379080/wm_africa-ipad_lehdst_c_crop_ar_3_4_dzpkjq.png","Wave Maps Africa view on iPad",{"comp_type":90,"comp_var":91,"link":99,"description":559,"imgs":560},"The Soul of the 911",[561],{"ruta":13,"alt":97},{},"projects/wave-maps","hyygn9jTuyP32mjQOPsvz6xMO4hVqiSAETibSf_7Xyg",1777359078673]